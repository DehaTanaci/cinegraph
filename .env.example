# Copy to .env and fill in. Never commit .env.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_HEAP=2G
NEO4J_PAGECACHE=1G

# --- Dataset ---
# ml-latest-small (100k ratings, fast) or ml-25m (25M ratings, slow, needs more memory)
DATASET=ml-latest-small
DATA_DIR=./data/raw

# --- LLM (local Ollama by default) ---
# From inside Docker, the host's Ollama app is reachable at host.docker.internal.
# Use http://ollama:11434 if you start the optional `ollama` compose profile.
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SECONDS=120

# --- Security ---
# Required in the X-API-Key header for admin endpoints (recomputing graph algorithms).
ADMIN_API_KEY=change-me-too

# --- Docker image published to a public registry ---
API_IMAGE=cinegraph-api:dev
